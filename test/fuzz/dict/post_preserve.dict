"%"
"%27"
"%22"
"%3C"
"%3E"
"%0d%0a"
"'"
"\""
"\\"
"/"
"<"
">"
"</script>"
"<script>"
"\x0a"
"\x0d"
"https://www.example.com/protected/"
"javascript:"
